+            // arr-images: ask the PreImportValidator (preimport-validator.properties) whether this download may be
+            // imported yet. Not ready (or no answer) leaves it in Downloading/ImportBlocked, so the next queue
+            // refresh asks again; a failure marks it failed (blocklisted, removed from the client when that client's
+            // Remove Failed Downloads is on). With no validator configured nothing here runs.
+            if (_preImportValidator.IsConfigured)
+            {
+                var preImport = _preImportValidator.Check(trackedDownload.ImportItem.OutputPath.FullPath);
+
+                if (preImport.Status == PreImportStatus.Failed)
+                {
+                    _logger.Warn("PreImportValidator failed '{0}': {1}", trackedDownload.DownloadItem.Title, preImport.Message);
+                    trackedDownload.State = TrackedDownloadState.Failed;
+                    _failedDownloadService.MarkAsFailed(trackedDownload, preImport.Message);
+
+                    return;
+                }
+
+                if (preImport.Status != PreImportStatus.Ready)
+                {
+                    return;
+                }
+            }
+
             trackedDownload.State = TrackedDownloadState.ImportPending;
         }
 
