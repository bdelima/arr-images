+    // arr-images: a `.tdarr-hold` marker lets an external pre-import process (a hook that strips non-English
+    // audio/subtitle tracks and embedded images, say) hold one download back from import without touching the
+    // download client. For a download whose output is a folder the marker is `<folder>/.tdarr-hold`; for a
+    // single-file download it is `<file>.tdarr-hold` next to the file (a marker in the shared parent folder would
+    // hold every download in it). The path is the one the client reported, translated with the same remote path
+    // mappings the import uses, so the marker is looked for where this container sees the files. Any failure here
+    // lets the import proceed as upstream would.
+    private async Task<bool> IsHeldByTdarrMarkerAsync(DownloadQueueItem download, SportarrDbContext? db)
+    {
+        if (string.IsNullOrWhiteSpace(download.OutputPath))
+        {
+            return false;
+        }
+
+        try
+        {
+            var host = download.DownloadClient?.Host;
+            if (host == null && download.DownloadClientId != null && db != null)
+            {
+                host = (await db.DownloadClients.AsNoTracking()
+                    .FirstOrDefaultAsync(c => c.Id == download.DownloadClientId))?.Host;
+            }
+
+            var path = download.OutputPath;
+            if (host != null)
+            {
+                using var scope = _serviceProvider.CreateScope();
+                var pathMapping = scope.ServiceProvider.GetRequiredService<IRemotePathMappingService>();
+                path = await pathMapping.RemapRemoteToLocalAsync(host, path);
+            }
+
+            return Directory.Exists(path)
+                ? File.Exists(Path.Combine(path, ".tdarr-hold"))
+                : File.Exists(path + ".tdarr-hold");
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "[Enhanced Download Monitor] Could not check for a Tdarr hold marker for '{Title}'; importing as usual", download.Title);
+            return false;
+        }
+    }
+
     private async Task HandleCompletedDownload(
         DownloadQueueItem download,
         DownloadClientService downloadClientService,
         FileImportService fileImportService,
         SportarrDbContext? db = null)
     {
+        // arr-images: held back by a `.tdarr-hold` marker (see IsHeldByTdarrMarkerAsync). Nothing is touched, so
+        // no state changes and no import attempt is counted; the next poll after the marker is gone imports
+        // exactly as if this block were not here.
+        if (await IsHeldByTdarrMarkerAsync(download, db))
+        {
+            _logger.LogDebug("[Enhanced Download Monitor] Tdarr hold marker present for '{Title}', deferring import", download.Title);
+            return;
+        }
+
         // Set-once: CompletedAt is the moment the download first finished, not the
         // last poll. Re-imports (ImportPending retries) re-enter this method every
         // poll; resetting CompletedAt here would keep the extraction grace window
