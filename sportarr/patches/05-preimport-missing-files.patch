+    // arr-images: true when the client reports a torrent as missing files and the PreImportValidator answers ready with
+    // a path that passes the guard (it exists and is the reported folder or a file directly in it): the file was
+    // converted or renamed, not deleted. False for everything else (not ready, failed, no path, validator not
+    // configured or unreachable, pack downloads), so those keep their current failure handling.
+    private async Task<bool> ConvertedMissingFilesAsync(DownloadQueueItem download, DownloadClientStatus status, SportarrDbContext? db)
+    {
+        if (download.IsPack || string.IsNullOrWhiteSpace(download.OutputPath) ||
+            status.ErrorMessage == null || !status.ErrorMessage.StartsWith("Missing files", StringComparison.Ordinal))
+        {
+            return false;
+        }
+
+        var preImportValidator = GetPreImportValidator();
+        if (!preImportValidator.IsConfigured)
+        {
+            return false;
+        }
+
+        try
+        {
+            var tags = await ResolveLeagueTagLabelsAsync(download, db);
+            var reportedPath = await ResolveDownloadPathAsync(download, db);
+            var preImport = await preImportValidator.CheckAsync(reportedPath, tags);
+
+            return preImport.Status == PreImportStatus.Ready &&
+                   !string.IsNullOrEmpty(preImport.Path) &&
+                   PreImportValidator.IsReplacementPath(reportedPath, preImport.Path);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogDebug(ex, "[Enhanced Download Monitor] Could not ask the pre-import check about the missing files of '{Title}'", download.Title);
+            return false;
+        }
+    }
+
