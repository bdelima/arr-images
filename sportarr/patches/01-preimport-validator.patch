+    private PreImportValidator GetPreImportValidator()
+    {
+        if (_preImportValidator == null)
+        {
+            var config = _serviceProvider.GetRequiredService<IConfiguration>();
+            var dataPath = config["Sportarr:DataPath"] ?? Path.Combine(Directory.GetCurrentDirectory(), "data");
+            _preImportValidator = new PreImportValidator(dataPath, _logger);
+        }
+
+        return _preImportValidator;
