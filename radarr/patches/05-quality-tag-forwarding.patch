+        // arr-images: the one arr-side tag on the movie that names a Tdarr quality tier, so the
+        // PreImportValidator can tell the sidecar which quality-tier library to scan this download into
+        // (see tdarr-download-validator's TDARR_LIBRARY_MAP). Multiple quality tags on one movie is a
+        // configuration mistake, not a crash: the lowest-sorting label wins and the rest are logged.
+        // No matching tag (the common case for anything not using tiered libraries) returns null, and the
+        // validator falls back to its own default library.
+        private string ResolveQualityTag(TrackedDownload trackedDownload, HashSet<int> tagIds)
+        {
+            if (tagIds == null || tagIds.Count == 0)
+            {
+                return null;
+            }
+
+            var matches = _tagService.GetTags(tagIds)
+                                      .Where(t => QualityTag.KnownLabels.Contains(t.Label))
+                                      .OrderBy(t => t.Label)
+                                      .ToList();
+
+            if (matches.Count > 1)
+            {
+                _logger.Warn("'{0}' has more than one quality tag ({1}); using '{2}'",
+                    trackedDownload.DownloadItem.Title, string.Join(", ", matches.Select(t => t.Label)), matches[0].Label);
+            }
+
+            return matches.Count > 0 ? matches[0].Label : null;
+        }
