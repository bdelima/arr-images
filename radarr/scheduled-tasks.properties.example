# scheduled-tasks.properties for the bdelima/radarr image. Put it in the /config folder.
#
# Name=minutes. 0 turns that task's own schedule off. Remove the leading # to use a line.
# Names are the "taskName" values of GET /api/v3/system/task (case-insensitive).
# Read once at start: restart the container after editing.
#
# The numbers shown are upstream's defaults at the time this image was built.

#MessagingCleanup=5
#ImportListSync=5
#ApplicationCheckUpdate=360
#CheckHealth=360
#RefreshMovie=1440
#RefreshCollections=1440
#Housekeeping=1440
#CleanUpRecycleBin=1440

# These three normally follow Settings (Settings > General / Indexers / Download Clients); a value here
# wins over Settings, including after Settings is saved.
#Backup=10080
#RssSync=30
#RefreshMonitoredDownloads=1
